# Supabase → Project Settings → API.
# The legacy anon/service_role keys and the newer publishable/secret keys
# both work here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# React Bits Pro license (component registry).
REACTBITS_LICENSE_KEY=

# Bank transfer details shown on the order confirmation.
BANK_IBAN=
BANK_BIC=
BANK_HOLDER=
