# Supabase → Project Settings → API.
# The legacy anon/service_role keys and the newer publishable/secret keys
# both work here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# React Bits Pro license (component registry).
REACTBITS_LICENSE_KEY=

# Bank transfer details shown on the order confirmation.
BANK_IBAN=
BANK_BIC=
BANK_HOLDER=

# Email (Resend). Test sends from onboarding@resend.dev only reach your
# own Resend account address; switch to your domain once it is verified.
RESEND_API_KEY=
EMAIL_FROM=Prime <onboarding@resend.dev>
# Where customer replies go (optional).
EMAIL_REPLY_TO=
# Gets a copy of every order-received email (optional).
EMAIL_ORDER_COPY_TO=

# Public shop URL, used for links in emails.
SITE_URL=http://localhost:3000

# Protects /api/cron/* (Vercel sends it as a Bearer token).
CRON_SECRET=
